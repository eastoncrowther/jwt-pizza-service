{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "JWT Pizza Service backend: ECS Fargate cluster and service behind an HTTPS Application Load Balancer.",
  "Parameters": {
    "ServiceName": {
      "Description": "Name used for the ECS cluster, ECS service, load balancer, and target group",
      "Type": "String",
      "Default": "jwt-pizza-service"
    },
    "TaskDefinition": {
      "Description": "ECS task definition family (uses latest ACTIVE revision) or family:revision",
      "Type": "String",
      "Default": "jwt-pizza-service"
    },
    "ContainerName": {
      "Description": "Name of the container in the task definition that receives traffic",
      "Type": "String",
      "Default": "jwt-pizza-service"
    },
    "VpcID": {
      "Description": "VPC to deploy into",
      "Type": "AWS::EC2::VPC::Id",
      "Default": "vpc-07acb1c6ea3ec6528"
    },
    "SubnetIDs": {
      "Description": "Subnets for the load balancer and ECS tasks (at least two availability zones)",
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Default": "subnet-0245d78e738c83005,subnet-0ce40487ba35b92de,subnet-0fe33f13df5e6f7ac,subnet-024dcab35420bc5db"
    },
    "SecurityGroupIDs": {
      "Description": "Security groups for the load balancer and ECS tasks",
      "Type": "List<AWS::EC2::SecurityGroup::Id>",
      "Default": "sg-0b8c8e1ab5f42c085"
    },
    "CertificateArn": {
      "Description": "ACM certificate ARN for the HTTPS listener",
      "Type": "String",
      "Default": "arn:aws:acm:us-east-1:545009834748:certificate/943ffa8b-cefd-4218-9ce1-e0e5b07e9388"
    }
  },
  "Resources": {
    "ECSCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": { "Ref": "ServiceName" },
        "CapacityProviders": ["FARGATE"]
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": { "Ref": "ServiceName" },
        "Type": "application",
        "Scheme": "internet-facing",
        "IpAddressType": "ipv4",
        "Subnets": { "Ref": "SubnetIDs" },
        "SecurityGroups": { "Ref": "SecurityGroupIDs" }
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": { "Ref": "ServiceName" },
        "VpcId": { "Ref": "VpcID" },
        "TargetType": "ip",
        "Protocol": "HTTP",
        "Port": 80,
        "HealthCheckProtocol": "HTTP",
        "HealthCheckPath": "/api/docs",
        "Matcher": { "HttpCode": "200" }
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": { "Ref": "LoadBalancer" },
        "Protocol": "HTTPS",
        "Port": 443,
        "Certificates": [{ "CertificateArn": { "Ref": "CertificateArn" } }],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": { "Ref": "TargetGroup" }
          }
        ]
      }
    },
    "ECSService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": ["Listener"],
      "Properties": {
        "ServiceName": { "Ref": "ServiceName" },
        "Cluster": { "Ref": "ECSCluster" },
        "TaskDefinition": { "Ref": "TaskDefinition" },
        "LaunchType": "FARGATE",
        "DesiredCount": 1,
        "HealthCheckGracePeriodSeconds": 60,
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": { "Ref": "SubnetIDs" },
            "SecurityGroups": { "Ref": "SecurityGroupIDs" }
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": { "Ref": "ContainerName" },
            "ContainerPort": 80,
            "TargetGroupArn": { "Ref": "TargetGroup" }
          }
        ]
      }
    }
  },
  "Outputs": {
    "ClusterName": {
      "Description": "ECS cluster name",
      "Value": { "Ref": "ECSCluster" }
    },
    "ServiceName": {
      "Description": "ECS service name",
      "Value": { "Fn::GetAtt": ["ECSService", "Name"] }
    },
    "LoadBalancerDNS": {
      "Description": "Point the pizza-service DNS record at this name",
      "Value": { "Fn::GetAtt": ["LoadBalancer", "DNSName"] }
    }
  }
}
